DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_NAME=mdc
DATABASE_USER=mdc
DATABASE_PASSWORD=mdc
DATABASE_HOST=db
DATABASE_PORT=5432
DJANGO_RUN_MIGRATIONS=true
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=MDC <noreply@example.com>
SERVER_EMAIL=MDC <noreply@example.com>
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_SEND_DEFAULT_PII=0
DJANGO_USE_S3=0
AWS_ACCESS_KEY_ID=example-access-key
AWS_SECRET_ACCESS_KEY=example-secret-key
AWS_STORAGE_BUCKET_NAME=mdc-media
AWS_S3_ENDPOINT_URL=https://s3.faramir.com.br
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ADDRESSING_STYLE=path
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_QUERYSTRING_AUTH=1
AWS_QUERYSTRING_EXPIRE=300
AWS_DEFAULT_ACL=private
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_URL_PROTOCOL=https:
