{
  "scripts": {
    "build:css": "tailwindcss -i ./static/src/input.css -o ./static/css/app.css --minify",
    "build:js": "mkdir -p ./static/js && cp ./node_modules/alpinejs/dist/cdn.min.js ./static/js/alpine.min.js",
    "watch:css": "tailwindcss -i ./static/src/input.css -o ./static/css/app.css --watch"
  },
  "dependencies": {
    "alpinejs": "^3.15.12",
    "flowbite": "latest"
  },
  "devDependencies": {
    "@tailwindcss/cli": "latest",
    "tailwindcss": "latest"
  }
}
